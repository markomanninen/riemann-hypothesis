def pureTypeSign (b : Bool) : ℤˣ := if b then 1 else -1

theorem sgnRt_eq_sign_mul {E : Type} [Field E] [NumberField E] [IsCMField E] (H : Host E) (b : Bool) :
    sgnRt H b = ((pureTypeSign b : ℤ) : ℂ) * H.rt0 := by
  cases b <;> simp [sgnRt, pureTypeSign]

