  ∀ (κ' κ'' : Type) [Fintype κ'] [Fintype κ''] (l : ((κ' ⊕ κ'' → AF F) → ℂ) →ₗ[ℂ] ℂ),
    l ∈ (adeleClass F).adm (κ' ⊕ κ'') →
    (∀ (y : κ'' → AF F), ∀ Ψ ∈ schA F (κ' ⊕ κ''), l (fun x => ψ ((x ∘ Sum.inr) ⬝ᵥ y) * Ψ x) = l Ψ) →
