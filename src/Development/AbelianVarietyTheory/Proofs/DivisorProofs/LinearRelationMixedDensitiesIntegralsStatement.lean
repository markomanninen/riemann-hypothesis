  first | exact @GlobalTheory.Mix.sum_int_eq_zero_of_dens | exact GlobalTheory.Mix.sum_int_eq_zero_of_dens | (intros; apply GlobalTheory.Mix.sum_int_eq_zero_of_dens <;> assumption)
