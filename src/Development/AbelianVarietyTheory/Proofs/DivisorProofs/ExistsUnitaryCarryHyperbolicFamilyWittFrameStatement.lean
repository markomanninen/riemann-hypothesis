  first | exact @GlobalTheory.WittCarry.exists_GF_carry_hyperbolic | exact GlobalTheory.WittCarry.exists_GF_carry_hyperbolic | (intros; apply GlobalTheory.WittCarry.exists_GF_carry_hyperbolic <;> assumption)
