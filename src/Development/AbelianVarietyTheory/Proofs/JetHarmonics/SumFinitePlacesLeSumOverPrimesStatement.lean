  first | exact @GlobalTheory.PlaceSum.finsum_le_sum_primes | exact GlobalTheory.PlaceSum.finsum_le_sum_primes | (intros; apply GlobalTheory.PlaceSum.finsum_le_sum_primes <;> assumption)
