  intro B X I l Z L hT Gi Gl Kc Yd cX ex W hW t PP hPP j hj
  have hl : (_root_.GlobalTheory.Fam.pk_z W).toLevCh.Is W.P.A3.A.μ0 := hW.pk.bot.hyp.2.2.2.1.lev
  refine ⟨⟨_, hl.βY j hj⟩, fun PP' hPP' e => ?_⟩
